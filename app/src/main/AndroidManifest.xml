<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" package="com.juan.movil">
    <uses-permission android:name="android.permission.INTERNET" />

    <application android:allowBackup="true" android:dataExtractionRules="@xml/data_extraction_rules" android:fullBackupContent="@xml/backup_rules" android:icon="@drawable/logonewhdp" android:label="@string/app_name" android:roundIcon="@mipmap/ic_launcher_round" android:supportsRtl="true" android:theme="@style/Theme.Movil" tools:targetApi="31">

        <!--  Actividad principal al iniciar la app  -->
        <activity android:name=".SplashActivity" android:exported="true" android:theme="@style/Theme.Movil.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!--  Pantalla de login  -->
        <activity android:name=".InicioSesion" android:exported="false"/>
        <!--  Pantalla de bienvenida  -->
        <activity android:name=".PantallaPrincipal" android:exported="false"/>
        <!--  Menú principal  -->
        <activity android:name=".MenuActivity" android:exported="false" android:label="@string/app_name" android:theme="@style/Theme.Movil.NoActionBar"/>
        <!--  Otras pantallas  -->
        <activity android:name=".CrearActividad" android:exported="false"/>
        <activity android:name=".Registro" android:exported="false"/>
        <activity android:name=".MainActivity" android:exported="false"/>
    </application>
</manifest>