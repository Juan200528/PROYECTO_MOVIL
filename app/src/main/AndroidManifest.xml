<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.juan.movil">

    <!-- Permiso para acceder a Internet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logonewhdp"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Movil"
        tools:targetApi="31">

        <!-- Pantalla principal (launcher) -->
        <activity
            android:name=".PantallaPrincipal"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla de inicio de sesión -->
        <activity
            android:name=".InicioSesion"
            android:exported="false" />

        <!-- Pantalla de registro -->
        <activity
            android:name=".Registro"
            android:exported="false" />

        <!-- Menú principal -->
        <activity
            android:name=".MenuActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Movil.NoActionBar" />

    </application>
</manifest>
