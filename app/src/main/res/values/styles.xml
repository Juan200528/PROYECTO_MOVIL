        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="ButtonWithBorder" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@android:color/white</item>
        <!--  fondo blanco  -->
        <item name="strokeColor">#D32F2F</item>
        <!--  borde rojo  -->
