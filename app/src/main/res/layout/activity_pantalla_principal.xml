<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    android:background="#FFFFFF"
    tools:context=".MainActivity">

    <!-- Logo -->
    <ImageView
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/logoprincipal"
        android:layout_marginBottom="16dp"/>

    <!-- Título -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PANASCOOP"
        android:textSize="24sp"
        android:textColor="#000000"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <!-- Subtítulo -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bienvenido a Panascoop, tu plataforma confiable para gestionar y conectar con tu cooperativa."
        android:textSize="16sp"
        android:textColor="#666666"
        android:layout_marginBottom="48dp"
        android:gravity="center"
        android:layout_gravity="center"
        android:maxWidth="300dp"/>

    <!-- Botón de Registrar -->
    <Button
        android:id="@+id/btnRegister"
        android:layout_width="225dp"
        android:layout_height="50dp"
        android:text="Registrar"
        android:textColor="#FFFFFF"
        android:backgroundTint="#03683E"
        android:layout_marginBottom="16dp"/>

    <!-- Botón de Iniciar Sesión con borde (corregido: solo primera letra en mayúscula) -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnLogin"
        style="@style/Base.Widget.AppCompat.Button.Borderless"
        android:layout_width="225dp"
        android:layout_height="50dp"
        android:background="@drawable/button_border"
        android:text="Iniciar sesión"
        android:textAllCaps="false"
        android:textColor="#166534" />
</LinearLayout>